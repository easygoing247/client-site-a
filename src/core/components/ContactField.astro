---
// ============================================================================
// ContactField.astro — お問い合わせフォームの入力欄1つ（ラベル＋必須/任意バッジ＋入力）
// 固定項目（ContactFormField）とカスタム追加項目（CustomContactField）の
// 両方を、共通の ContactRenderField 形に正規化してから渡す（ContactFields.astro）。
// ============================================================================
import type { ContactRenderField } from '../lib/pages';

interface Props {
  field: ContactRenderField;
}

const { field } = Astro.props;
const inputClass = 'px-4 py-[14px] border border-formBorder rounded-lg text-[14px]';
const options = field.options ?? [];
---

<label class="flex flex-col gap-1.5">
  <span class="text-[13px] font-bold text-secondary flex items-center gap-2">
    {field.label}
    {field.required ? (
      <span class="text-[10px] font-bold text-white bg-required rounded px-1.5 py-[3px] leading-none">必須</span>
    ) : (
      <span class="text-[10px] font-bold text-ink-faint bg-surface-muted rounded px-1.5 py-[3px] leading-none">任意</span>
    )}
  </span>
  {field.type === 'textarea' ? (
    <textarea
      name={field.key}
      rows="5"
      required={field.required}
      placeholder={field.placeholder}
      class:list={[inputClass, 'resize-y']}
    />
  ) : field.type === 'select' ? (
    <select name={field.key} required={field.required} class:list={[inputClass, 'bg-white appearance-none']}>
      <option value="" disabled selected>{field.placeholder || '選択してください'}</option>
      {options.map((opt) => (
        <option value={opt}>{opt}</option>
      ))}
    </select>
  ) : (
    <input
      type={field.type}
      name={field.key}
      required={field.required}
      placeholder={field.placeholder}
      autocomplete={field.autocomplete}
      class={inputClass}
    />
  )}
</label>
