---
// ============================================================================
// Header.astro — サイト共通ヘッダー（ロゴ／PCナビ／スマホハンバーガー）
// ============================================================================
import { Image } from 'astro:assets';
import { site, visibleNavItems } from '../lib/site';
import { resolveImageOrNull } from '../lib/images';
import MobileMenuButton from './MobileMenuButton.astro';
import MobileNavDrawer from './MobileNavDrawer.astro';

const logo = resolveImageOrNull(site.company.logo);
const nav = visibleNavItems(site.nav);
// ロゴ画像が無い、または「テキストロゴを使用する」がONの場合は
// テキストロゴ（未入力なら会社名）を表示する。
const showTextLogo = !logo || site.company.useTextLogo === true;
const textLogo = site.company.textLogo || site.company.name;
---

<header
  class="sticky top-0 z-50 border-b border-surface-border bg-white/95 backdrop-blur-sm"
>
  <div class="max-w-[1200px] mx-auto px-5 py-[14px] flex items-center justify-between gap-4">
    {(logo || textLogo) && (
      <a href="/" aria-label="トップページへ戻る" class="flex items-center">
        {showTextLogo
          ? (textLogo && <span class="text-[20px] font-bold text-secondary leading-none">{textLogo}</span>)
          : (logo && <Image src={logo} alt={`${site.company.name} ロゴ`} class="h-7 w-auto object-contain" width={161} height={63} format="webp" quality={80} />)
        }
      </a>
    )}

    <!-- デスクトップナビ（タブレット幅768〜1023pxではメニュー項目数によって
         折り返し・表示崩れが起きやすいため、lg=1024px以上でのみ表示する。
         768〜1023pxの範囲はスマホと同じハンバーガーメニューにフォール
         バックする＝MobileMenuButton.astro/MobileNavDrawer.astroの
         lg:hiddenと対にすること。2026-09） -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[15px] font-bold text-secondary hover:text-primary transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      {site.navCta.label && site.navCta.href && (
        <a
          href={site.navCta.href}
          class="text-[14px] font-bold text-white bg-primary px-[22px] py-[10px] rounded-full hover:bg-primary-dark transition-colors"
        >
          {site.navCta.label}
        </a>
      )}
    </nav>

    <MobileMenuButton />
  </div>

  <MobileNavDrawer items={nav} ctaLabel={site.navCta.label} ctaHref={site.navCta.href} />
</header>
