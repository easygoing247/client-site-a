---
// ============================================================================
// BackToTop.astro — 最上部へ戻るボタン（自己完結）
// ============================================================================
---

<button
  id="back-to-top"
  type="button"
  aria-label="ページの最上部へ戻る"
  class="fixed right-4 bottom-20 md:right-6 md:bottom-6 z-40 w-11 h-11 rounded-full flex items-center justify-center opacity-0 pointer-events-none text-white bg-gradient-to-br from-primary to-primary-dark"
  style="box-shadow:0 8px 20px -6px rgba(var(--color-primary-rgb),0.55);"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M12 5l-6 6M12 5l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const backToTop = document.getElementById('back-to-top') as HTMLButtonElement;

  // scroll イベントごとに DOM を触ると強制リフロー／ロングタスクの原因に
  // なるため、requestAnimationFrame で1フレーム1回に間引き、さらに表示状態が
  // 変わったときだけ class を書き換える（毎フレームの無駄な DOM 更新を防ぐ）。
  let ticking = false;
  let visible: boolean | null = null;

  function applyBackToTop() {
    ticking = false;
    const show = window.scrollY > 480;
    if (show === visible) return;
    visible = show;
    backToTop.classList.toggle('opacity-0', !show);
    backToTop.classList.toggle('pointer-events-none', !show);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(applyBackToTop);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  applyBackToTop();

  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
