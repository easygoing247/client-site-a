---
// ============================================================================
// Works.astro — 「実績・活用事例」（features.enableWorks で表示制御）
// カードは型化ページ（Content Collections: works）から取得する。個別ページ
// （/works/[slug]）が実在するため、カード自体が /works/[slug] へのリンクになる。
// ・表示件数は site.works.count（先頭N件。既定3）。
// ・並び順は site.works.order（CMS「表示順序」リストのドラッグ&ドロップ）を
//   優先し、未掲載の実績は公開日の新しい順でその後ろに続く（個別記事側の
//   数値「表示順」フィールドは、この表示順序リストへ一本化されたことに伴い
//   9.38で廃止した）。
// ・PC表示の並列カード枚数は site.works.columns（既定3、1〜3）。表示件数が
//   その枚数を超える場合は、両端の矢印クリック／フリック／下部ドット
//   インジケーターでスライド閲覧する（外部ライブラリ不使用：CSS
//   scroll-snap のネイティブ機構を使う）。矢印・ドットのJSロジックは
//   「サービス内容」「商品一覧」「料金プラン」のスマホスライダーと共通の
//   src/scripts/cardSlider.ts（data-slider-root/-track/-prev/-next/-dots
//   の構成）を使う。他の3つと異なり、Worksのスライダーは列数超過時は
//   PC幅でも有効（sm:hidden 等の幅指定はしていない）。
// ============================================================================
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site, isSectionEnabled } from '../lib/site';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const count = Number(site.works.count) > 0 ? Math.floor(Number(site.works.count)) : 3;
const columns = Math.min(3, Math.max(1, Math.floor(Number(site.works.columns)) || 3));

const allWorks = await getCollection('works');

// 「表示順序」（CMSでドラッグ&ドロップした slug のリスト）を優先し、
// そこに無い実績は公開日の新しい順でその後ろに続ける。
// 各項目は `{ item: slug }` というオブジェクト（2026-09、Task 2。
// Decap CMSの delete ボタン不具合対応で配列の要素形式を変更した。
// src/core/lib/site.ts の SiteInfo['works']['order'] コメント参照）。
const orderList = (site.works.order ?? [])
  .map((entry) => entry?.item)
  .filter((slug): slug is string => !!slug && String(slug).trim() !== '');
const bySlug = new Map<string, (typeof allWorks)[number]>(allWorks.map((w) => [w.slug, w]));
const seen = new Set<string>();
const ordered: typeof allWorks = [];
orderList.forEach((slug) => {
  const work = bySlug.get(slug);
  if (work && !seen.has(slug)) {
    ordered.push(work);
    seen.add(slug);
  }
});
allWorks
  .filter((w) => !seen.has(w.slug))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
  .forEach((w) => ordered.push(w));

const works = ordered.slice(0, count);
// 矢印はいったんマークアップに含めておき、実際にオーバーフローしている
// かどうか（PCで表示件数が columns 超、またはスマホで2件以上など）は
// クライアント側で scrollWidth を実測して判定する（下部の script タグ参照）。
// ここでは「そもそも2件以上あるか」だけで有無を決める。
const isSlider = works.length > 1;
---

{
  isSectionEnabled('works') && works.length > 0 && (
    <section id="works" class:list={['py-16 px-5', muted && 'bg-surface-muted']} aria-labelledby="works-heading">
      <div class="max-w-[1100px] mx-auto">
        <div class="text-center mb-10">
          {site.works.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.works.eyebrow}
            </div>
          )}
          {site.works.heading && (
            <h2 id="works-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.works.heading}
            </h2>
          )}
        </div>

        <div class="relative" data-slider-root>
          <div
            data-slider-track
            class="works-track"
            style={`--works-cols:${columns};`}
          >
            {works.map((work) => (
              <!--
                スマホ（md未満）は「画像単体」ではなく「画像＋テキストを
                含めたカード全体」のシルエットが正方形に近くなるよう、
                カードを flex flex-col aspect-square のコンテナ化する。
                画像自体は横長（aspect-video）のまま保ち、残りの高さを
                テキスト領域（flex-1）に割り当てる。md以上はaspect-noneで
                解除し、画像は元の固定高さ（170px）に戻る。
              -->
              <a
                href={`/works/${work.slug}/`}
                class="works-card flex flex-col aspect-square md:aspect-auto bg-white rounded-card overflow-hidden border border-surface-border hover:shadow-lg transition-shadow"
              >
                {work.data.image && (
                  <Image
                    src={work.data.image}
                    alt={work.data.imageAlt || (work.data.title ? `${work.data.title}の実績イメージ` : '')}
                    class="w-full flex-none aspect-video md:aspect-auto md:h-[170px] object-cover block"
                    width={450}
                    height={253}
                    format="webp"
                    quality={80}
                    loading="lazy"
                  />
                )}
                <div class="flex-1 px-4 py-4 md:py-6">
                  {work.data.title && <h3 class="font-bold text-[15px] mb-1">{work.data.title}</h3>}
                  {work.data.summary && (
                    <p class="text-[12px] text-ink-soft m-0 line-clamp-2 whitespace-pre-line">{work.data.summary}</p>
                  )}
                  {typeof work.data.price === 'number' && (
                    <div class="text-[14px] font-bold text-primary mt-2">
                      ¥{work.data.price.toLocaleString('ja-JP')}<span class="text-[11px] font-normal text-ink-soft">〜</span>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>

          {isSlider && (
            <>
              <button
                type="button"
                data-slider-prev
                aria-label="前の実績を表示"
                class="works-arrow works-arrow-prev absolute top-1/2 -translate-y-1/2 left-0 md:-left-4 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button
                type="button"
                data-slider-next
                aria-label="次の実績を表示"
                class="works-arrow works-arrow-next absolute top-1/2 -translate-y-1/2 right-0 md:-right-4 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </>
          )}
        </div>

        {isSlider && (
          <div class="flex justify-center gap-1.5 mt-5" data-slider-dots role="tablist" aria-label="表示中の実績">
            {works.map((_, i) => (
              <button
                type="button"
                data-slider-dot
                aria-label={`${i + 1}枚目の実績を表示`}
                class="w-2 h-2 rounded-full bg-surface-border transition-colors"
              />
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import '../scripts/cardSlider.ts';
</script>
