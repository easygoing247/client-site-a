---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import { site } from '../lib/site';
import { resolveImageOrNull } from '../lib/images';
import { siteSettings } from '../lib/siteSettings';
import SmoothScroll from '../components/SmoothScroll.astro';

interface Props {
  title?: string;
  description?: string;
  /** OGP/Twitterカード用の画像（省略時は site.company.ogImage を使用） */
  image?: ImageMetadata;
}

const { title = site.company.siteName, description = site.company.description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OGP画像はSNS側のクローラーがそのまま読み込める絶対URLの静的ファイルである
// 必要があるため、astro:assets の getImage() で1200x630のJPGに最適化した上で
// Astro.site と結合して絶対URL化する。どちらの画像も未設定の場合はOGP画像
// 自体を出力しない（画像なしでもtitle/description等は機能する）。
const ogImageSource = image ?? resolveImageOrNull(site.company.ogImage);
const optimizedOgImage = ogImageSource
  ? await getImage({ src: ogImageSource, width: 1200, height: 630, format: 'jpg' })
  : null;
const ogImageURL = optimizedOgImage ? new URL(optimizedOgImage.src, Astro.site).toString() : null;
---

<!doctype html>
<html lang="ja" data-theme={siteSettings.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />

    <!-- OGP（Facebook / LINE 等） -->
    <meta property="og:type" content="website" />
    {site.company.siteName && <meta property="og:site_name" content={site.company.siteName} />}
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalURL} />
    {title && <meta property="og:title" content={title} />}
    {description && <meta property="og:description" content={description} />}
    {ogImageURL && (
      <>
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter（X）カード -->
    <meta name="twitter:card" content="summary_large_image" />
    {title && <meta name="twitter:title" content={title} />}
    {description && <meta name="twitter:description" content={description} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <!--
      フォントは Google Fonts 等の外部CDNを使わず、OS標準搭載のシステム
      フォントのみで表示する（font-sans の定義は tailwind.config.mjs 参照）。
      これにより、フォント関連の外部ネットワークリクエストが完全になくなり、
      レンダリングブロッキング要因を根本から排除している。
      <link rel="preconnect"> や Google Fonts の <link rel="stylesheet">・
      @import は意図的に使用していない。
    -->

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-surface overflow-x-hidden">
    <!--
      .layout-shell = 縦フレックスの Sticky Footer ラッパー（src/styles/global.css）。
      中身は各ページが差し込む <Header> / <main> / <Footer> …。<main> が伸縮し、
      コンテンツが短いページでもフッターが常に画面最下部に来る。
    -->
    <div class="layout-shell">
      <slot />
    </div>
    <SmoothScroll />
  </body>
</html>
