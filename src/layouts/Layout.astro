---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import { site } from '../lib/site';
import { resolveImage } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  /** OGP/Twitterカード用の画像（省略時は site.company.ogImage を使用） */
  image?: ImageMetadata;
}

const { title = site.company.siteName, description = site.company.description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OGP画像はSNS側のクローラーがそのまま読み込める絶対URLの静的ファイルである
// 必要があるため、astro:assets の getImage() で1200x630のJPGに最適化した上で
// Astro.site と結合して絶対URL化する。
const ogImageSource = image ?? resolveImage(site.company.ogImage);
const optimizedOgImage = await getImage({ src: ogImageSource, width: 1200, height: 630, format: 'jpg' });
const ogImageURL = new URL(optimizedOgImage.src, Astro.site).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OGP（Facebook / LINE 等） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company.siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter（X）カード -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!--
      フォントは Google Fonts 等の外部CDNを使わず、OS標準搭載のシステム
      フォントのみで表示する（font-sans の定義は tailwind.config.mjs 参照）。
      これにより、フォント関連の外部ネットワークリクエストが完全になくなり、
      レンダリングブロッキング要因を根本から排除している。
      <link rel="preconnect"> や Google Fonts の <link rel="stylesheet">・
      @import は意図的に使用していない。
    -->

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-surface overflow-x-hidden">
    <slot />
  </body>
</html>
