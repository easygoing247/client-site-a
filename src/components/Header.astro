---
// ============================================================================
// Header.astro — サイト共通ヘッダー（ロゴ／PCナビ／スマホハンバーガー）
// ============================================================================
import { Image } from 'astro:assets';
import { site, visibleNavItems } from '../lib/site';
import { resolveImageOrNull } from '../lib/images';
import MobileMenuButton from './MobileMenuButton.astro';
import MobileNavDrawer from './MobileNavDrawer.astro';

const logo = resolveImageOrNull(site.company.logo);
const nav = visibleNavItems(site.nav);
---

<header
  class="sticky top-0 z-50 border-b border-surface-border bg-white/95 backdrop-blur-sm"
>
  <div class="max-w-[1200px] mx-auto px-5 py-[14px] flex items-center justify-between gap-4">
    {logo && (
      <a href="/" aria-label="トップページへ戻る">
        <Image src={logo} alt={`${site.company.name} ロゴ`} class="h-7 w-auto object-contain" width={161} height={63} />
      </a>
    )}

    <!-- デスクトップナビ -->
    <nav class="hidden md:flex items-center gap-8" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[15px] font-bold text-secondary hover:text-primary transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      {site.navCta.label && site.navCta.href && (
        <a
          href={site.navCta.href}
          class="text-[14px] font-bold text-white bg-primary px-[22px] py-[10px] rounded-full hover:bg-primary-dark transition-colors"
        >
          {site.navCta.label}
        </a>
      )}
    </nav>

    <MobileMenuButton />
  </div>

  <MobileNavDrawer items={nav} ctaLabel={site.navCta.label} ctaHref={site.navCta.href} />
</header>
