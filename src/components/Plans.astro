---
// ============================================================================
// Plans.astro — 「料金プラン」（features.enablePlans で表示制御）
// スマホ幅（640px未満）では横スクロール＋スナップの1枚送りスライダー
// （矢印クリック／スワイプ対応）、sm以上（PC・タブレット）では従来の
// CSS Gridをそのまま維持する。実装は「サービス内容」「商品一覧」
// （Service.astro / Products.astro）と同じ考え方で、スタイルは
// global.css の `.card-slider-mobile`、JSは共通の src/scripts/cardSlider.ts
// を使う。
// 「含まれる内容」チェックリストのチェックマークは、画像（旧 site.icons.check
// の低解像度PNG）ではなくインラインSVG（stroke: var(--color-primary)）で
// 描画する。画像では実現できないテーマカラー連動が必要なため（/services
// ページの料金表チェックリストと同じアイコン・実装）。
// ============================================================================
import { site } from '../lib/site';
import Button from './Button.astro';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const planButton = site.plans.buttonLabel && site.plans.buttonHref;
const isSlider = (site.plans.items?.length ?? 0) > 1;
---

{
  site.features.enablePlans && (
    <section id="plans" class:list={['py-16', muted && 'bg-surface-muted']} aria-labelledby="plans-heading">
      <div class="max-w-xl sm:max-w-2xl lg:max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-5">
        <div class="text-center mb-10">
          {site.plans.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.plans.eyebrow}
            </div>
          )}
          {site.plans.heading && (
            <h2 id="plans-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.plans.heading}
            </h2>
          )}
        </div>
        <div class="relative" data-slider-root>
          <!--
            人気プランの「人気No.1」バッジは absolute -top-[14px] でカード
            自身の上端よりさらに上へはみ出す配置になっている。
            .card-slider-mobile はスマホ幅で overflow-x:auto を指定しており、
            CSS仕様上 overflow-x が visible 以外だと overflow-y も自動的に
            auto 扱いになる（= overflow-x:auto と overflow-y:visible を
            共存させることはできない）ため、何も対策しないとこのバッジの
            上半分がスクロールコンテナの上端でクリップされて見切れてしまう。
            スクロールコンテナ自身（このtrack）に pt-6（sm以上は従来どおり
            pt-0 に戻す）を足し、バッジのはみ出し分をコンテナの
            パディング領域内に収めることでクリップを回避する。
          -->
          <div data-slider-track class="card-slider-mobile grid lg:grid-cols-3 gap-6 items-stretch pt-6 sm:pt-0">
            {site.plans.items.map((plan) => (
              <div
                class:list={[
                  'relative rounded-2xl p-7 bg-white flex flex-col items-center text-center h-full',
                  plan.popular ? 'border-2 border-primary' : 'border border-surface-border',
                ]}
                style={plan.popular ? 'box-shadow:0 16px 32px -12px rgba(var(--color-primary-rgb),0.28);' : undefined}
              >
                {plan.popular && site.plans.popularBadgeLabel && (
                  <div class="absolute -top-[14px] left-1/2 -translate-x-1/2 bg-primary text-white text-[11px] font-bold px-[14px] py-[5px] rounded-full whitespace-nowrap">
                    {site.plans.popularBadgeLabel}
                  </div>
                )}
                {plan.name && <h3 class:list={['text-[17px] font-bold mb-1', plan.popular && 'mt-2']}>{plan.name}</h3>}
                {plan.description && <p class="text-[12px] text-ink-soft mb-5">{plan.description}</p>}
                {!!plan.price && (
                  <div class="text-[28px] font-bold mb-6">
                    ¥{plan.price.toLocaleString('ja-JP')}
                    <span class="text-[14px] font-normal text-ink-soft">〜</span>
                  </div>
                )}
                {plan.features?.length > 0 && (
                  <ul class="list-none m-0 p-0 flex flex-col gap-3 w-fit mx-auto text-left">
                    {plan.features
                      .filter((feature) => feature)
                      .map((feature) => (
                        <li class="flex gap-2 items-center text-[13px] text-secondary-light">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none">
                            <path d="M4 12.5l5 5L20 6" style="stroke: var(--color-primary);" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          {feature}
                        </li>
                      ))}
                  </ul>
                )}
                {planButton && (
                  <div class="mt-auto pt-7 w-full">
                    <Button
                      href={site.plans.buttonHref}
                      label={site.plans.buttonLabel}
                      variant={plan.popular ? 'solid' : 'outline'}
                      class={
                        plan.popular
                          ? 'w-full shadow-[0_14px_30px_-8px_rgba(var(--color-primary-rgb),0.55)]'
                          : 'w-full'
                      }
                    />
                  </div>
                )}
              </div>
            ))}
          </div>

          {isSlider && (
            <>
              <button
                type="button"
                data-slider-prev
                aria-label="前のプランを表示"
                class="sm:hidden absolute top-[calc(50%+12px)] -translate-y-1/2 left-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button
                type="button"
                data-slider-next
                aria-label="次のプランを表示"
                class="sm:hidden absolute top-[calc(50%+12px)] -translate-y-1/2 right-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </>
          )}
        </div>

        {isSlider && (
          <div class="flex justify-center gap-1.5 mt-5 sm:hidden" data-slider-dots role="tablist" aria-label="表示中のプラン">
            {site.plans.items.map((_, i) => (
              <button
                type="button"
                data-slider-dot
                aria-label={`${i + 1}枚目のプランを表示`}
                class="w-2 h-2 rounded-full bg-surface-border transition-colors"
              />
            ))}
          </div>
        )}

        {site.plans.note && <p class="text-center text-[12px] text-ink-faint mt-6">{site.plans.note}</p>}
      </div>
    </section>
  )
}

<script>
  import '../scripts/cardSlider.ts';
</script>
