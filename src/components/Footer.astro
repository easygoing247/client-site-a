---
// ============================================================================
// Footer.astro — 共通フッター（ロゴ＋SNS／ヘッダーと同じメニュー2列／プライバシー導線）
// 背景色は固定のネイビーではなく、デザインテーマ設定のメインカラーに連動する
// 専用トーン（`--color-footer-bg` ＝ tailwind.config.mjs の bg-footer-bg）を使う。
// ボタン・グラデーション等で使う鮮やかな `--color-primary-dark` をそのまま
// フッターのような広い面積に敷くと、特に赤・オレンジ系のテーマで圧迫感が
// 出るため、同じ色相を保ちつつ彩度を落とし明度を下げた「シックなダーク
// トーン」を別変数として持たせている（詳細は global.css の :root コメント
// 参照）。5プリセットいずれの footer-bg も white と 9:1 以上のコントラストに
// なるよう選定済みのため、本文・リンク・SNSアイコン・著作権表記はすべて
// 白（text-white）で統一し、どのテーマ色でも WCAG AA（4.5:1）を安定して
// 満たす（透過白などの中間トーンは使わない）。
// ============================================================================
import { Image } from 'astro:assets';
import { site, visibleNavItems } from '../lib/site';
import { resolveImageOrNull } from '../lib/images';
import { orderedSnsLinks } from '../lib/sns';

const logo = resolveImageOrNull(site.company.logo);
const showTextLogo = !logo || site.company.useTextLogo === true;
const textLogo = site.company.textLogo || site.company.name;
const footerNav = visibleNavItems(site.footerNav);
// 2列レイアウトの行数は、表示される項目数に合わせて動的に算出する
// （非表示セクションが増えても不自然な空白行ができないようにするため）
const footerNavRows = Math.max(1, Math.ceil(footerNav.length / 2));

// 表示順序・非表示条件は管理画面（siteInfo.yml トップレベルの sns リスト＝
// 「SNS設定」）と「店舗概要・アクセス」セクションに完全連動する（src/lib/sns.ts 参照）。
const snsLinks = orderedSnsLinks();
---

<footer class="bg-footer-bg text-white pt-12 px-5 pb-24 md:pb-10 text-[12px]">
  <div class="max-w-[900px] mx-auto flex flex-col md:flex-row md:justify-between gap-9 mb-9">
    <!-- 左：ロゴ＋SNS -->
    <div class="text-center md:text-left">
      {showTextLogo
        ? (textLogo && <p class="text-[18px] font-bold text-white mb-4 leading-none">{textLogo}</p>)
        : (logo && (
            <Image
              src={logo}
              alt={`${site.company.name} ロゴ`}
              class="h-6 w-auto object-contain mb-4 mx-auto md:mx-0 block"
              width={161}
              height={63}
            />
          ))
      }
      <div class:list={['flex items-center justify-center md:justify-start gap-3', snsLinks.length === 0 && 'hidden']}>
        {
          snsLinks.map((sns) => (
            <a
              href={sns.href}
              aria-label={sns.label}
              class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/30 transition-colors"
            >
              {sns.isFrame ? (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" stroke="#fff" stroke-width="1.8" />
                  <circle cx="12" cy="12" r="4" stroke="#fff" stroke-width="1.8" />
                  <circle cx="17.2" cy="6.8" r="1.1" fill="#fff" />
                </svg>
              ) : (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={sns.icon} fill="#fff" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- 右：ヘッダーと同じメニューを2列で配置 -->
    <nav
      class="grid grid-cols-2 grid-flow-col gap-x-12 gap-y-3 text-center md:text-left justify-center md:justify-start"
      style={`grid-template-rows: repeat(${footerNavRows}, auto);`}
      aria-label="フッターナビゲーション"
    >
      {
        footerNav.map((item) => (
          <a href={item.href} class="text-white hover:underline underline-offset-2">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  {(site.ui.privacyPolicyLabel || site.copyright) && (
    <div class="text-center border-t border-white/20 pt-6">
      {site.ui.privacyPolicyLabel && (
        <a href="/privacy" class="text-white underline hover:no-underline">{site.ui.privacyPolicyLabel}</a>
      )}
      {site.copyright && <div class="mt-2 text-white">{site.copyright}</div>}
    </div>
  )}
</footer>
