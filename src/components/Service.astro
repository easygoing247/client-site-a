---
// ============================================================================
// Service.astro — 「サービス・事業内容」
// 見出し・リンク文言は siteInfo.yml の `services`（トップページ専用の設定）、
// カード個別項目（画像・タイトル・説明）は「下層ページ ＞ サービス内容・料金」
// の `services.yml`「サービス詳細」（`servicesPage.items`）を単一のデータソースと
// して参照する（二重管理防止）。/services ページ（`src/pages/services.astro`）と
// 完全に同じ項目・並び順を共有する。
// スマホ幅（640px未満）では横スクロール＋スナップの1枚送りスライダー
// （矢印クリック／スワイプ対応）。スタイルは global.css の
// `.card-slider-mobile`、JSは共通の src/scripts/cardSlider.ts を使う
// （Products.astro と共有）。
// md以上（768px〜）では2列×2行のグリッドに切り替え、各カードは
// 「左：画像／右：タイトル・バッジ・説明」の横長レイアウトになる
// （md未満〜sm相当のタブレット幅は、アスペクト比の制約だけ外した
// 縦積み1カラムの中間表示になる。`.card-slider-mobile`のスライダー
// 解除自体はsm=640pxで起きるため、カード自体の見た目もアスペクト比
// だけは同じ640pxで解除し、不自然な正方形の巨大カードにならないように
// している）。
// ============================================================================
import { Image } from 'astro:assets';
import { site } from '../lib/site';
import { servicesPage } from '../lib/pages';
import { resolveImageOrNull } from '../lib/images';
import Button from './Button.astro';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const items = servicesPage.items ?? [];
const isSlider = items.length > 1;
---

{
  site.features.enableServices && (
    <section id="services" class:list={['py-16 px-5', muted && 'bg-surface-muted']} aria-labelledby="services-heading">
      <div class="max-w-[1100px] mx-auto">
        <div class="text-center mb-10">
          {site.services.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.services.eyebrow}
            </div>
          )}
          {site.services.heading && (
            <h2 id="services-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.services.heading}
            </h2>
          )}
        </div>
        <div class="relative" data-slider-root>
          <div data-slider-track class="card-slider-mobile grid md:grid-cols-2 gap-5">
            {items.map((item) => {
              const image = resolveImageOrNull(item.image);
              return (
                <!--
                  スマホ（sm未満）は「画像単体」ではなく「画像＋テキストを
                  含めたカード全体」のシルエットが正方形に近くなるよう、
                  カードを flex flex-col aspect-square のコンテナ化する。
                  画像自体は横長（aspect-video）のまま保ち、残りの高さを
                  テキスト領域（flex-1）に割り当てる。
                  sm以上（640px〜）はaspect-square/aspect-videoを解除し、
                  縦積み・画像は幅に応じた自然な高さに戻る（タブレット幅の
                  中間表示）。md以上（768px〜）はさらに flex-row に切り替え、
                  画像を左側に幅38%・カード全高で固定し（object-coverで
                  トリミング）、右側にタイトル・バッジ・説明を縦中央寄せで
                  配置する「横長カード」レイアウトになる。
                -->
                <article class="flex flex-col aspect-square sm:aspect-auto md:flex-row border border-surface-border rounded-card overflow-hidden bg-white">
                  {image && (
                    <Image
                      src={image}
                      alt={item.title ? `${item.title}のイメージ` : ''}
                      class="w-full flex-none aspect-video md:aspect-auto md:w-[38%] md:h-full object-cover block"
                      width={400}
                      height={225}
                      format="webp"
                      quality={80}
                      loading="lazy"
                    />
                  )}
                  {/*
                    overflow-hiddenは付けない：aspect-squareはあくまで
                    「目安の比率」であり、テキストが長い場合はカードが
                    正方形より縦に伸びることを許容し、内容が見切れて
                    隠れてしまわないようにする。
                  */}
                  <div class="flex-1 px-[18px] py-4 md:py-6 md:px-7 md:flex md:flex-col md:justify-center">
                    {item.title && (
                      <h3 class="flex items-center flex-wrap gap-x-2 gap-y-1 font-bold text-[15px] mb-2">
                        {item.badgeText && (
                          <span class="inline-flex items-center rounded-full bg-primary text-white text-[10px] font-bold leading-none px-2 py-1 whitespace-nowrap">
                            {item.badgeText}
                          </span>
                        )}
                        {item.title}
                      </h3>
                    )}
                    {item.description && <p class="text-[13px] leading-[1.7] text-ink-soft m-0 whitespace-pre-line">{item.description}</p>}
                  </div>
                </article>
              );
            })}
          </div>

          {isSlider && (
            <>
              <button
                type="button"
                data-slider-prev
                aria-label="前のサービスを表示"
                class="sm:hidden absolute top-1/2 -translate-y-1/2 left-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button
                type="button"
                data-slider-next
                aria-label="次のサービスを表示"
                class="sm:hidden absolute top-1/2 -translate-y-1/2 right-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </>
          )}
        </div>

        {isSlider && (
          <div class="flex justify-center gap-1.5 mt-5 sm:hidden" data-slider-dots role="tablist" aria-label="表示中のサービス">
            {items.map((_, i) => (
              <button
                type="button"
                data-slider-dot
                aria-label={`${i + 1}枚目のサービスを表示`}
                class="w-2 h-2 rounded-full bg-surface-border transition-colors"
              />
            ))}
          </div>
        )}

        {site.services.linkLabel && site.services.linkHref && (
          <div class="text-center mt-10">
            <Button href={site.services.linkHref} label={site.services.linkLabel} variant="outline" />
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import '../scripts/cardSlider.ts';
</script>
