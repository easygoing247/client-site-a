---
// ============================================================================
// Products.astro — 型化ページ（Content Collections）一覧セクション
// site.features.enableProducts が true の竹/松プランでのみ表示される。
// 梅プラン（1ページLP）では enableProducts: false のため非表示。
// ============================================================================
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const enabled = site.features.enableProducts;
const products = enabled
  ? (await getCollection('products')).sort((a, b) => a.data.order - b.data.order)
  : [];
---

{
  enabled && products.length > 0 && (
    <section id="products" class:list={['py-16 px-5', muted && 'bg-surface-muted']} aria-labelledby="products-heading">
      <div class="max-w-[1100px] mx-auto">
        <div class="text-center mb-10">
          {site.productsSection.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.productsSection.eyebrow}
            </div>
          )}
          {site.productsSection.heading && (
            <h2 id="products-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.productsSection.heading}
            </h2>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((product) => (
            <!--
              スマホ（md未満）は「画像単体」ではなく「画像＋テキストを
              含めたカード全体」のシルエットが正方形に近くなるよう、
              カードを flex flex-col aspect-square のコンテナ化する。
              画像自体は横長（aspect-video）のまま保ち、残りの高さを
              テキスト領域（flex-1）に割り当てる。md以上はaspect-noneで
              解除し、画像は元の固定高さ（170px）に戻る。
              overflow-hiddenはテキスト側には付けない：aspect-squareは
              あくまで「目安の比率」であり、内容が見切れて隠れてしまう
              ことがないようにする。
            -->
            <a
              href={`/products/${product.slug}/`}
              class="flex flex-col aspect-square md:aspect-auto bg-white rounded-card overflow-hidden border border-surface-border hover:shadow-lg transition-shadow"
            >
              {product.data.mainImage && (
                <Image
                  src={product.data.mainImage}
                  alt={product.data.title ?? ''}
                  class="w-full flex-none aspect-video md:aspect-auto md:h-[170px] object-cover block"
                  width={450}
                  height={253}
                  format="webp"
                  loading="lazy"
                />
              )}
              <div class="flex-1 p-4">
                {product.data.title && <h3 class="font-bold text-[15px] mb-1">{product.data.title}</h3>}
                {product.data.summary && (
                  <p class="text-[12px] text-ink-soft mb-2 line-clamp-2 whitespace-pre-line">{product.data.summary}</p>
                )}
                {!!product.data.price && (
                  <div class="text-[16px] font-bold text-primary">¥{product.data.price.toLocaleString('ja-JP')}〜</div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
