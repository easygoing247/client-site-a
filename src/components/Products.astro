---
// ============================================================================
// Products.astro — トップページ「商品一覧」セクション
// データは CMS「商品作成」（src/data/products.yml、src/lib/pages.ts の
// productsPage）を単一の情報源として参照する（/products ページと共通）。
// 「セクション表示順序」の products が非表示、または商品が1件も登録されていない
// 場合は非表示。表示区分（featured/regular/both）は問わず、登録順の先頭
// site.productsSection.count 件を表示する。
// スマホ幅（640px未満）では横スクロール＋スナップの1枚送りスライダー
// （矢印クリック／スワイプ対応）、sm以上（PC・タブレット）では従来の
// CSS Gridをそのまま維持する。実装は「実績・活用事例」（Works.astro）と
// 同じ考え方だが、PC側の見た目を変えない点が異なるため、スタイルは
// global.css の `.card-slider-mobile`、JSは共通の src/scripts/cardSlider.ts
// を使う（Service.astro と共有）。
// ============================================================================
import { Image } from 'astro:assets';
import { site, isSectionEnabled } from '../lib/site';
import { productsPage, resolveAllProductItems } from '../lib/pages';
import { resolveImageOrNull } from '../lib/images';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const enabled = isSectionEnabled('products');
const count = Number(site.productsSection.count) > 0 ? Math.floor(Number(site.productsSection.count)) : 4;
const items = enabled ? resolveAllProductItems(productsPage.items).slice(0, count) : [];
const isSlider = items.length > 1;
---

{
  enabled && items.length > 0 && (
    <section id="products" class:list={['py-16 px-5', muted && 'bg-surface-muted']} aria-labelledby="products-heading">
      <div class="max-w-[1100px] mx-auto">
        <div class="text-center mb-10">
          {site.productsSection.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.productsSection.eyebrow}
            </div>
          )}
          {site.productsSection.heading && (
            <h2 id="products-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.productsSection.heading}
            </h2>
          )}
        </div>
        <div class="relative" data-slider-root>
          <div data-slider-track class="card-slider-mobile grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {items.map((item) => {
              const image = resolveImageOrNull(item.image);
              return (
                <article class="relative flex flex-col aspect-square md:aspect-auto bg-white rounded-card overflow-hidden border border-surface-border">
                  {item.showBadge && item.badgeText && (
                    <span class="absolute top-3 left-3 z-10 inline-flex items-center rounded-full bg-primary text-white text-[10px] font-bold leading-none px-2 py-1 whitespace-nowrap">
                      {item.badgeText}
                    </span>
                  )}
                  {image && (
                    <Image
                      src={image}
                      alt={item.alt || (item.name ? `${item.name}のイメージ` : '')}
                      class="w-full flex-none aspect-video md:aspect-auto md:h-[150px] object-cover block"
                      width={400}
                      height={225}
                      format="webp"
                      quality={80}
                      loading="lazy"
                    />
                  )}
                  <div class="flex-1 px-[18px] py-4 md:py-5">
                    {item.name && <h3 class="font-bold text-[15px] mb-1">{item.name}</h3>}
                    {item.description && (
                      <p class="text-[12px] leading-[1.7] text-ink-soft mb-2 line-clamp-2 whitespace-pre-line">{item.description}</p>
                    )}
                    {typeof item.price === 'number' && (
                      <div class="text-[15px] font-bold text-primary">¥{item.price.toLocaleString('ja-JP')}〜</div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>

          {isSlider && (
            <>
              <button
                type="button"
                data-slider-prev
                aria-label="前の商品を表示"
                class="sm:hidden absolute top-1/2 -translate-y-1/2 left-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button
                type="button"
                data-slider-next
                aria-label="次の商品を表示"
                class="sm:hidden absolute top-1/2 -translate-y-1/2 right-0 z-10 w-9 h-9 rounded-full bg-white border border-surface-border shadow flex items-center justify-center disabled:opacity-30 disabled:cursor-default"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" class="text-secondary" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </>
          )}
        </div>

        {isSlider && (
          <div class="flex justify-center gap-1.5 mt-5 sm:hidden" data-slider-dots role="tablist" aria-label="表示中の商品">
            {items.map((_, i) => (
              <button
                type="button"
                data-slider-dot
                aria-label={`${i + 1}枚目の商品を表示`}
                class="w-2 h-2 rounded-full bg-surface-border transition-colors"
              />
            ))}
          </div>
        )}

        {site.productsSection.linkLabel && site.productsSection.linkHref && (
          <div class="text-center mt-10">
            <a
              href={site.productsSection.linkHref}
              class="inline-flex items-center justify-center gap-2 font-bold text-[15px] px-8 py-4 rounded-full text-primary bg-white border border-primary"
            >
              {site.productsSection.linkLabel} <span aria-hidden="true">›</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import '../scripts/cardSlider.ts';
</script>
