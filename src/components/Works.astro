---
// ============================================================================
// Works.astro — 「実績・活用事例」（features.enableWorks で表示制御）
// ============================================================================
import { Image } from 'astro:assets';
import { site } from '../lib/site';
import { resolveImageOrNull } from '../lib/images';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
---

{
  site.features.enableWorks && (
    <section id="works" class:list={['py-16 px-5', muted && 'bg-surface-muted']} aria-labelledby="works-heading">
      <div class="max-w-[1100px] mx-auto">
        <div class="text-center mb-10">
          {site.works.eyebrow && (
            <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
              {site.works.eyebrow}
            </div>
          )}
          {site.works.heading && (
            <h2 id="works-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
              {site.works.heading}
            </h2>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {site.works.items.map((item) => {
            const image = resolveImageOrNull(item.image);
            return (
              <!--
                スマホ（md未満）は「画像単体」ではなく「画像＋テキストを
                含めたカード全体」のシルエットが正方形に近くなるよう、
                カードを flex flex-col aspect-square のコンテナ化する。
                画像自体は横長（aspect-video）のまま保ち、残りの高さを
                テキスト領域（flex-1）に割り当てる。md以上はaspect-noneで
                解除し、画像は元の固定高さ（170px）に戻る。
                overflow-hiddenはテキスト側には付けない：aspect-squareは
                あくまで「目安の比率」であり、内容が見切れて隠れてしまう
                ことがないようにする。
              -->
              <article class="flex flex-col aspect-square md:aspect-auto bg-white rounded-card overflow-hidden border border-surface-border">
                {image && (
                  <Image
                    src={image}
                    alt={item.title ? `${item.title}の実績イメージ` : ''}
                    class="w-full flex-none aspect-video md:aspect-auto md:h-[170px] object-cover block"
                    width={450}
                    height={253}
                    format="webp"
                    loading="lazy"
                  />
                )}
                <div class="flex-1 px-4 py-4 md:py-6">
                  {item.title && <h3 class="font-bold text-[15px] mb-1">{item.title}</h3>}
                  {item.industry && <p class="text-[12px] text-ink-soft mb-[10px] whitespace-pre-wrap">{item.industry}</p>}
                  {item.tag && (
                    <span class="inline-block text-[11px] font-bold text-primary bg-primary-light px-[10px] py-1 rounded-full">
                      {item.tag}
                    </span>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}
