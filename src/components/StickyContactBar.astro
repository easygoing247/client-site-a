---
// ============================================================================
// StickyContactBar.astro — スマホ専用：画面下部固定の「電話・LINE」問い合わせバー
// md以上（PC表示）では非表示になる。
// 各ボタンは管理画面の表示トグル（showPhoneButton/showLineButton）と、
// 対応する値（電話番号／LINE URL）が入力されているかの両方で表示制御する。
//   ・両方表示 → 50% / 50%
//   ・片方のみ → 100%
//   ・両方非表示 → バー自体を描画しない
// ============================================================================
import { site } from '../lib/site';

const showPhone = site.contact.showPhoneButton && !!site.contact.phone;
const showLine = site.contact.showLineButton && !!site.contact.lineUrl;
---

{(showPhone || showLine) && (
  <div
    class="fixed left-0 right-0 bottom-0 z-[60] md:hidden"
    role="complementary"
    aria-label="お問い合わせショートカット"
  >
    <div class:list={['grid', showPhone && showLine ? 'grid-cols-2' : 'grid-cols-1']}>
      {showPhone && (
        <a
          href={site.contact.phoneHref}
          class="flex items-center justify-center gap-2 text-white font-bold text-[14px] py-4 bg-gradient-to-br from-primary to-primary-dark"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.62 10.79a15.09 15.09 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"
              fill="#fff"
            />
          </svg>
          <span>{site.contact.phoneLabel}</span>
        </a>
      )}
      {showLine && (
        <a
          href={site.contact.lineUrl}
          class="flex items-center justify-center gap-2 bg-accent text-white font-bold text-[14px] tracking-wide py-4 [text-shadow:0_1px_2px_rgba(0,0,0,0.35)]"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="drop-shadow-[0_1px_1px_rgba(0,0,0,0.3)]"
          >
            <path
              d="M12 3C6.48 3 2 6.69 2 11.24c0 4.08 3.58 7.49 8.42 8.13.33.07.78.22.89.5.1.26.07.66.03.92l-.14.87c-.04.26-.2 1 .88.55 1.07-.46 5.8-3.42 7.92-5.85C21.34 14.86 22 13.13 22 11.24 22 6.69 17.52 3 12 3Z"
              fill="#ffffff"
            />
          </svg>
          <span class="text-white">{site.contact.lineLabel}</span>
        </a>
      )}
    </div>
  </div>
)}
