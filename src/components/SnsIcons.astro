---
// ============================================================================
// SnsIcons.astro — 公式SNSアイコンの横並び（トップページ「店舗概要・アクセス」
// セクションと /about ページの「公式SNS」行で共通利用）。
// 表示順序・非表示条件は src/lib/sns.ts の orderedSnsLinks() に一元化。
// アイコンの配色はこの見た目（実装詳細）としてここで持つ。
// ============================================================================
import { orderedSnsLinks, type SnsId } from '../lib/sns';

// 配色はすべて tailwind.config.mjs の colors.* ／ src/styles/global.css の
// CSS変数（Design Tokens）を参照する（2026-09、Phase 3で直書きの
// カラーコードを撤去）。アイコン自体の色は各バッジの背景色に関わらず
// 常に白のため、fill/stroke は currentColor にして text-white で
// 明示する（このコードベース標準のアイコン配色パターン）。
const SNS_STYLE: Record<SnsId, { class: string }> = {
  line: { class: 'bg-accent' },
  instagram: { class: 'bg-sns-instagram' },
  x: { class: 'bg-secondary' },
  facebook: { class: 'bg-sns-facebook' },
  youtube: { class: 'bg-sns-youtube' },
  tiktok: { class: 'bg-sns-tiktok' },
};

const links = orderedSnsLinks().map((sns) => ({ ...sns, ...SNS_STYLE[sns.id] }));
---

{
  links.length > 0 && (
    <div class="flex items-center gap-2">
      {links.map((sns) => (
        <a
          href={sns.href}
          aria-label={sns.label}
          class:list={['flex-none w-9 h-9 rounded-full flex items-center justify-center text-white', sns.class]}
        >
          {sns.isFrame ? (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={sns.icon} fill="currentColor" />
            </svg>
          )}
        </a>
      ))}
    </div>
  )
}
