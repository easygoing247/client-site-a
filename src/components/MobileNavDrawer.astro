---
// ============================================================================
// MobileNavDrawer.astro
// スマホ・タブレット表示用：開閉ドロワー本体。lg=1024px未満（タブレット
// 768〜1023px含む）で使用し、MobileMenuButton.astro/Header.astroの
// デスクトップナビと対になるブレイクポイント（lg:hidden）を使う。
// ヘッダーの横並び行（flex row）の“外側”に、幅100%の兄弟要素として配置する
// こと（PC表示で高さ0のまま横幅だけ確保してレイアウトを崩すのを防ぐため）。
// CTAボタン（ctaLabel/ctaHref）は他の項目（テキストリンク＋下線区切り）とは
// 見た目を分け、Header.astro のデスクトップCTA・BackToTop.astro と同じ
// 「primary→primary-dark のグラデーション塗り＋pill形状＋primaryカラーの
// ドロップシャドウ」の目立つボタンスタイルにしている（2026-09。色は
// テーマカラーのCSS変数 `--color-primary` 系に連動するため、デザイン
// テーマ設定を切り替えれば自動的に追従する）。
// ============================================================================
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
  ctaLabel: string;
  ctaHref: string;
}

const { items, ctaLabel, ctaHref } = Astro.props;
---

<nav id="mobile-nav" class="lg:hidden" aria-label="モバイルナビゲーション">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-5 py-[14px] text-[15px] font-bold text-secondary border-b border-surface-border"
      >
        {item.label}
      </a>
    ))
  }
  {ctaLabel && ctaHref && (
    <div class="px-5 py-4">
      <a
        href={ctaHref}
        class="mobile-nav-link flex items-center justify-center gap-2 text-white font-bold text-[15px] px-6 py-[14px] rounded-full bg-gradient-to-br from-primary to-primary-dark shadow-[0_8px_20px_-6px_rgba(var(--color-primary-rgb),0.55)]"
      >
        {ctaLabel}
      </a>
    </div>
  )}
</nav>

<script>
  const menuBtn = document.getElementById('menu-btn') as HTMLButtonElement;
  const mobileNav = document.getElementById('mobile-nav') as HTMLElement;
  const bar1 = document.getElementById('bar1') as HTMLElement;
  const bar2 = document.getElementById('bar2') as HTMLElement;
  const bar3 = document.getElementById('bar3') as HTMLElement;

  function setMenu(open: boolean) {
    menuBtn.setAttribute('aria-expanded', String(open));

    if (open) {
      mobileNav.style.maxHeight = mobileNav.scrollHeight + 'px';
      mobileNav.classList.add('nav-open');
    } else {
      mobileNav.style.maxHeight = '0px';
      mobileNav.classList.remove('nav-open');
    }

    bar1.style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
    bar2.style.opacity = open ? '0' : '1';
    bar3.style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
  }

  menuBtn.addEventListener('click', () => {
    setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
