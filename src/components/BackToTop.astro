---
// ============================================================================
// BackToTop.astro — 最上部へ戻るボタン（自己完結）
// モバイル時のbottomオフセットは、StickyContactBar.astro（画面下部固定バー）が
// 安全域（env(safe-area-inset-bottom)）ぶん高くなる場合があるため、
// 同じ計算式でその上に重ならないようにしている（2026-09）。
// ============================================================================
---

<button
  id="back-to-top"
  type="button"
  aria-label="ページの最上部へ戻る"
  class="fixed right-4 bottom-[calc(5rem+env(safe-area-inset-bottom,0px))] md:right-6 md:bottom-6 z-40 w-11 h-11 rounded-full flex items-center justify-center opacity-0 pointer-events-none bg-gradient-to-br from-primary to-primary-dark"
  style="box-shadow:0 8px 20px -6px rgba(var(--color-primary-rgb),0.55);"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M12 5l-6 6M12 5l6 6" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const backToTop = document.getElementById('back-to-top') as HTMLButtonElement;

  function updateBackToTop() {
    const show = window.scrollY > 480;
    backToTop.classList.toggle('opacity-0', !show);
    backToTop.classList.toggle('pointer-events-none', !show);
  }

  window.addEventListener('scroll', updateBackToTop, { passive: true });
  updateBackToTop();

  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
