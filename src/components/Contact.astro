---
// ============================================================================
// Contact.astro — お問い合わせフォーム
// 送信ボタン直下に「プライバシーポリシーに同意の上、送信してください」の
// リンク付き注記を標準配置（/privacy へリンク）。
// ============================================================================
import { site } from '../lib/site';
import { contactFormSettings } from '../lib/contactFormSettings';

interface Props {
  muted?: boolean;
}

const { muted = false } = Astro.props;
const formText = site.contactSection.form;
const cf = contactFormSettings;
---

{site.features.enableContact && (
<section id="contact" class:list={['py-16', muted && 'bg-surface-muted']} aria-labelledby="contact-heading">
  <div class="max-w-xl sm:max-w-2xl lg:max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-5">
    <div class="text-center mb-10">
      {site.contactSection.eyebrow && (
        <div class="text-[12px] tracking-[0.2em] text-primary font-bold mb-2" aria-hidden="true">
          {site.contactSection.eyebrow}
        </div>
      )}
      {site.contactSection.heading && (
        <h2 id="contact-heading" class="font-bold m-0" style="font-size:clamp(24px,3.4vw,32px);">
          {site.contactSection.heading}
        </h2>
      )}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        {site.contactSection.body && (
          <p class="text-[14px] leading-[1.9] text-secondary-light mb-6 whitespace-pre-line" set:html={site.contactSection.body} />
        )}
        {site.contactSection.points?.length > 0 && (
          <ul class="list-none p-0 m-0 flex flex-col gap-[14px]">
            {
              site.contactSection.points.filter((point) => point).map((point) => (
                <li class="text-[13px] text-secondary-light font-normal">・{point}</li>
              ))
            }
          </ul>
        )}
      </div>
      <form
        id="contact-form"
        novalidate
        class="flex flex-col gap-3"
        data-access-key={cf.web3forms_access_key}
        data-submit-label={formText.submitLabel}
        data-sending-label={formText.sendingLabel}
      >
        {/* スパム対策のハニーポット（人間には非表示。ボットが入力すると送信を弾く） */}
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {/* Web3Forms 通知メールの件名・差出人名（siteInfo.yml の contactForm を参照） */}
        {cf.contact_email_subject && <input type="hidden" name="subject" value={cf.contact_email_subject} />}
        {cf.contact_email_from_name && <input type="hidden" name="from_name" value={cf.contact_email_from_name} />}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <input
            type="text"
            name="name"
            placeholder={site.contactSection.form.namePlaceholder}
            required
            class="px-4 py-[14px] border border-[#dbdfe8] rounded-lg text-[14px]"
            aria-label={site.contactSection.form.namePlaceholder}
          />
          <input
            type="text"
            name="company"
            placeholder={site.contactSection.form.companyPlaceholder}
            class="px-4 py-[14px] border border-[#dbdfe8] rounded-lg text-[14px]"
            aria-label={site.contactSection.form.companyPlaceholder}
          />
        </div>
        <input
          type="email"
          name="email"
          placeholder={site.contactSection.form.emailPlaceholder}
          required
          class="px-4 py-[14px] border border-[#dbdfe8] rounded-lg text-[14px]"
          aria-label={site.contactSection.form.emailPlaceholder}
        />
        <textarea
          name="message"
          placeholder={site.contactSection.form.messagePlaceholder}
          rows="4"
          required
          class="px-4 py-[14px] border border-[#dbdfe8] rounded-lg text-[14px] resize-y"
          aria-label={site.contactSection.form.messagePlaceholder}
        ></textarea>
        <button
          type="submit"
          class="mt-1.5 text-white font-bold text-[15px] py-[15px] border-none rounded-full cursor-pointer hover:opacity-90 transition-opacity disabled:opacity-70 disabled:cursor-progress bg-gradient-to-br from-primary to-primary-dark"
        >
          <span class="contact-submit-label">{formText.submitLabel}</span> <span aria-hidden="true">›</span>
        </button>
        {site.ui.privacyPolicyLabel && (
          <p class="text-[12px] text-ink-faint text-center m-0">
            <a href="/privacy" class="text-primary underline">{site.ui.privacyPolicyLabel}</a>{site.ui.privacyConsentSuffix}
          </p>
        )}
      </form>
      {formText.successMessage && (
        <p
          id="contact-success"
          hidden
          role="status"
          class="mt-8 text-[14px] leading-[1.9] text-secondary-light text-center bg-primary-light rounded-2xl px-6 py-7"
        >
          {formText.successMessage}
        </p>
      )}
      {formText.errorMessage && (
        <p
          id="contact-error"
          hidden
          role="alert"
          class="mt-3 text-[13px] leading-[1.8] text-center text-[#b3261e] bg-[#fce8e6] rounded-lg px-5 py-3"
        >
          {formText.errorMessage}
        </p>
      )}
    </div>
  </div>
</section>
)}

<script>
  import '../scripts/contactForm.ts';
</script>
