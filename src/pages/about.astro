---
// ============================================================================
// src/pages/about.astro — 「店舗概要・アクセス」下層ページ
// データソースは src/data/about.yml（src/lib/pages.ts の aboutPage）。
// 連絡先・SNS・店舗名など siteInfo.yml 側にある共通情報はそちらを参照する。
// ============================================================================
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../lib/site';
import { aboutPage } from '../lib/pages';
import { resolveImageOrNull } from '../lib/images';

const heading = aboutPage.heading || '会社概要';
const sections = aboutPage.sections ?? {};
const greeting = aboutPage.greeting ?? {};
const greetingImage = resolveImageOrNull(greeting.image);
const profile = (aboutPage.profile ?? []).filter((row) => row.label && row.value);
const access = aboutPage.access ?? {};

const showGreeting = sections.greeting !== false && !!(greeting.heading || greeting.body || greeting.name);
const showCompanyOverview = sections.companyOverview !== false && profile.length > 0;
const showAccess =
  sections.access !== false && !!(access.address || access.directions || access.parking || access.mapEmbedUrl);
---

<Layout
  title={`${heading} | ${site.company.siteName}`}
  description={aboutPage.lead || site.company.description}
>
  <Header />
  <main>
    <PageHeader
      eyebrow="ABOUT"
      title={heading}
      lead={aboutPage.lead}
      crumbs={[{ label: site.productPage.breadcrumbHome || 'トップ', href: '/' }, { label: heading }]}
    />

    {showGreeting && (
      <section class="py-14 px-5">
        <div class="max-w-[900px] mx-auto grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 items-start">
          {greetingImage && (
            <div class="rounded-2xl overflow-hidden border border-surface-border">
              <Image
                src={greetingImage}
                alt={greeting.name ? `${greeting.name}の写真` : ''}
                class="w-full h-[240px] md:h-[260px] object-cover block"
                width={440}
                height={520}
                format="webp"
                fetchpriority="high"
                loading="eager"
              />
            </div>
          )}
          <div>
            {greeting.heading && <h2 class="text-[19px] font-bold mb-4">{greeting.heading}</h2>}
            {greeting.body && (
              <p class="text-[14px] leading-[1.9] text-secondary-light whitespace-pre-line mb-4">{greeting.body}</p>
            )}
            {greeting.name && (
              <p class="text-[13px] text-secondary font-bold m-0">{site.company.name}　代表　{greeting.name}</p>
            )}
          </div>
        </div>
      </section>
    )}

    {showCompanyOverview && (
      <section class="py-14 px-5 bg-surface-muted">
        <div class="max-w-[760px] mx-auto">
          <h2 class="text-center font-bold mb-8" style="font-size:clamp(20px,3vw,26px);">会社概要</h2>
          <dl class="rounded-2xl overflow-hidden border border-surface-border bg-white m-0">
            {profile.map((row, i) => (
              <div class:list={['grid grid-cols-1 sm:grid-cols-[140px_1fr]', i > 0 && 'border-t border-surface-border']}>
                <dt class="px-5 py-4 text-[13px] font-bold text-secondary bg-surface-muted sm:bg-transparent">{row.label}</dt>
                <dd class="px-5 pb-4 pt-0 sm:pt-4 text-[13px] leading-[1.9] text-secondary-light whitespace-pre-line m-0">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {showAccess && (
      <section class="py-14 px-5">
        <div class="max-w-[900px] mx-auto">
          <h2 class="text-center font-bold mb-8" style="font-size:clamp(20px,3vw,26px);">アクセス</h2>
          <dl class="grid grid-cols-[100px_1fr] gap-x-4 gap-y-[14px] text-[13px] text-secondary-light max-w-[600px] mx-auto m-0">
            {access.address && (<><dt class="font-bold text-secondary">住所</dt><dd class="m-0">{access.address}</dd></>)}
            {access.directions && (<><dt class="font-bold text-secondary">交通</dt><dd class="m-0 whitespace-pre-line">{access.directions}</dd></>)}
            {access.parking && (<><dt class="font-bold text-secondary">駐車場</dt><dd class="m-0">{access.parking}</dd></>)}
          </dl>
          {access.mapEmbedUrl && (
            <div class="mt-8 rounded-2xl overflow-hidden border border-surface-border">
              <iframe
                title={`Googleマップ：${site.company.name}周辺`}
                src={access.mapEmbedUrl}
                class="w-full h-[300px] sm:h-[360px] border-0 block"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          )}
        </div>
      </section>
    )}
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
