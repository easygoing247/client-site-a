---
// ============================================================================
// src/pages/about.astro — 「店舗概要・アクセス」下層ページ
// データソースは src/data/about.yml（src/lib/pages.ts の aboutPage）。
// 連絡先・SNS・店舗名など siteInfo.yml 側にある共通情報はそちらを参照する。
// ============================================================================
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../lib/site';
import { aboutPage, resolveAboutAccessItems } from '../lib/pages';
import { resolveImageOrNull } from '../lib/images';
import { objectPosition } from '../lib/objectPosition';
import { orderedSnsLinks } from '../lib/sns';
import SnsIcons from '../components/SnsIcons.astro';

const heading = aboutPage.heading || '会社概要';
const sections = aboutPage.sections ?? {};
const greeting = aboutPage.greeting ?? {};
const greetingImage = resolveImageOrNull(greeting.image);
const greetingImagePosition = objectPosition(greeting.imagePosition);
const profile = (aboutPage.profile ?? []).filter((row) => row.label && row.value);
const access = aboutPage.access ?? {};
const accessItems = resolveAboutAccessItems(access);
const companySnsLabel = aboutPage.companySnsLabel || '公式SNS';
const showCompanySns = orderedSnsLinks().length > 0;

const showGreeting = sections.greeting !== false && !!(greeting.heading || greeting.body || greeting.name);
const showCompanyOverview = sections.companyOverview !== false && (profile.length > 0 || showCompanySns);
const showAccess = sections.access !== false && (accessItems.length > 0 || !!access.mapEmbedUrl);

// 背景色のゼブラパターン：CMS で一部セクションを非表示にしても、
// 「実際に表示されるセクション」だけを数えて先頭から 白 → グレー → 白 … と
// 交互に割り当てる（index.astro のトップページと同じ考え方）。
const aboutSectionOrder = [
  { key: 'greeting', show: showGreeting },
  { key: 'companyOverview', show: showCompanyOverview },
  { key: 'access', show: showAccess },
] as const;
const mutedByKey: Record<string, boolean> = {};
aboutSectionOrder
  .filter((s) => s.show)
  .forEach((s, i) => {
    mutedByKey[s.key] = i % 2 === 1;
  });
---

<Layout
  title={`${heading} | ${site.company.siteName}`}
  description={aboutPage.lead || site.company.description}
>
  <Header />
  <main>
    <PageHeader
      eyebrow="ABOUT"
      title={heading}
      lead={aboutPage.lead}
      crumbs={[{ label: site.productPage.breadcrumbHome || 'トップ', href: '/' }, { label: heading }]}
    />

    {showGreeting && (
      <section class:list={['py-14 px-5', mutedByKey.greeting && 'bg-surface-muted']}>
        <div class="max-w-[900px] mx-auto grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8 items-start">
          {greetingImage && (
            <div class="rounded-2xl overflow-hidden border border-surface-border">
              <Image
                src={greetingImage}
                alt={greeting.name ? `${greeting.name}の写真` : ''}
                class="w-full h-[240px] md:h-[260px] object-cover block"
                style={greetingImagePosition && `object-position:${greetingImagePosition};`}
                width={440}
                height={520}
                format="webp"
                fetchpriority="high"
                loading="eager"
              />
            </div>
          )}
          <div>
            {greeting.heading && <h2 class="text-[19px] font-bold mb-4">{greeting.heading}</h2>}
            {greeting.body && (
              <p class="text-[14px] leading-[1.9] text-secondary-light whitespace-pre-line mb-4">{greeting.body}</p>
            )}
            {greeting.name && (
              <p class="text-[13px] text-secondary font-bold m-0">{site.company.name}　代表　{greeting.name}</p>
            )}
          </div>
        </div>
      </section>
    )}

    {showCompanyOverview && (
      <section class:list={['py-14 px-5', mutedByKey.companyOverview && 'bg-surface-muted']}>
        <div class="max-w-[760px] mx-auto">
          <h2 class="text-center font-bold mb-8" style="font-size:clamp(20px,3vw,26px);">会社概要</h2>
          <dl class="rounded-2xl overflow-hidden border border-surface-border bg-white m-0">
            {profile.map((row, i) => (
              <div class:list={['grid grid-cols-1 sm:grid-cols-[150px_1fr]', i > 0 && 'border-t border-surface-border']}>
                {/*
                  スマホ（sm未満）は dt が全幅の帯になる。セクション背景（白 /
                  bg-surface-muted）と同化せず、かつテーマカラーを主張しない
                  落ち着いたニュートラルグレーの帯（bg-surface-band = #e5e7eb）に
                  する。sm以上は左カラムに戻し、白カード上に溶け込ませる。
                */}
                <dt class="px-5 py-3 text-[13px] font-bold text-secondary bg-surface-band sm:bg-transparent sm:py-4">
                  {row.label}
                </dt>
                <dd class="px-5 pb-4 pt-3 sm:pt-4 text-[13px] leading-[1.9] text-secondary-light whitespace-pre-line m-0">
                  {row.value}
                </dd>
              </div>
            ))}
            {showCompanySns && (
              <div class:list={['grid grid-cols-1 sm:grid-cols-[150px_1fr] sm:items-center', profile.length > 0 && 'border-t border-surface-border']}>
                <dt class="px-5 py-3 text-[13px] font-bold text-secondary bg-surface-band sm:bg-transparent sm:py-4">
                  {companySnsLabel}
                </dt>
                <dd class="px-5 pb-4 pt-3 sm:pt-4 m-0">
                  <SnsIcons />
                </dd>
              </div>
            )}
          </dl>
        </div>
      </section>
    )}

    {showAccess && (
      <section class:list={['py-14 px-5', mutedByKey.access && 'bg-surface-muted']}>
        <div class="max-w-[900px] mx-auto">
          <h2 class="text-center font-bold mb-8" style="font-size:clamp(20px,3vw,26px);">アクセス</h2>
          {accessItems.length > 0 && (
            <dl class="grid grid-cols-[100px_1fr] gap-x-4 gap-y-[14px] text-[13px] text-secondary-light max-w-[600px] mx-auto m-0">
              {accessItems.map((row) => (
                <>
                  <dt class="font-bold text-secondary">{row.label}</dt>
                  <dd class="m-0 whitespace-pre-line">{row.value}</dd>
                </>
              ))}
            </dl>
          )}
          {access.mapEmbedUrl && (
            <div class="mt-8 rounded-2xl overflow-hidden border border-surface-border">
              <iframe
                title={`Googleマップ：${site.company.name}周辺`}
                src={access.mapEmbedUrl}
                class="w-full h-[300px] sm:h-[360px] border-0 block"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          )}
        </div>
      </section>
    )}
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
