---
// ============================================================================
// src/pages/index.astro — トップページ
// セクションの表示順序・表示/非表示は siteInfo.yml の `sectionOrder` と
// `features.*` フラグのみで決まる（本ファイルに順序をハードコードしない）。
// 背景の交互配色（白／グレー）も、実際に表示されるセクションだけを数えて
// 動的に算出するため、管理画面で並び替えても自動的に交互配色が保たれる。
// ============================================================================
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Service from '../components/Service.astro';
import Flow from '../components/Flow.astro';
import Products from '../components/Products.astro';
import Works from '../components/Works.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import Access from '../components/Access.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../lib/site';

const sectionComponents = {
  features: Features,
  services: Service,
  flow: Flow,
  products: Products,
  works: Works,
  plans: Plans,
  faq: Faq,
  access: Access,
  contact: Contact,
} as const;

type SectionId = keyof typeof sectionComponents;

const productCount = site.features.enableProducts ? (await getCollection('products')).length : 0;

const sectionEnabled: Record<SectionId, boolean> = {
  features: site.features.enableFeatures,
  services: site.features.enableServices,
  flow: site.features.enableFlow,
  products: site.features.enableProducts && productCount > 0,
  works: site.features.enableWorks,
  plans: site.features.enablePlans,
  faq: site.features.enableFaq,
  access: site.features.enableAccess,
  contact: site.features.enableContact,
};

const orderIds: SectionId[] =
  site.sectionOrder?.length > 0
    ? (site.sectionOrder.map((s) => s.id).filter((id) => id in sectionComponents) as SectionId[])
    : (Object.keys(sectionComponents) as SectionId[]);

// 表示されるセクションだけを数えて交互配色（偶数番目=グレー）を割り当てる
const visibleSections = orderIds
  .filter((id) => sectionEnabled[id])
  .map((id, i) => ({ id, Component: sectionComponents[id], muted: i % 2 === 0 }));
---

<Layout>
  <Header />
  <main>
    <Hero />
    {
      visibleSections.map(({ Component, muted }) => <Component muted={muted} />)
    }
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
