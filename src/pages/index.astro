---
// ============================================================================
// src/pages/index.astro — トップページ
// セクションの表示順序・表示/非表示は siteInfo.yml の `sectionOrder`
// （各項目の `id` と `enable`）のみで決まる（本ファイルに順序をハードコードしない）。
// 背景の交互配色（白／グレー）も、実際に表示されるセクションだけを数えて
// 動的に算出するため、管理画面で並び替えても自動的に交互配色が保たれる。
// ============================================================================
import { getCollection } from 'astro:content';
import Layout from '@core/layouts/Layout.astro';
import Header from '@core/components/Header.astro';
import Hero from '@core/components/Hero.astro';
import News from '@core/components/News.astro';
import Features from '@core/components/Features.astro';
import Service from '@core/components/Service.astro';
import Flow from '@core/components/Flow.astro';
import Products from '@core/components/Products.astro';
import Works from '@core/components/Works.astro';
import Plans from '@core/components/Plans.astro';
import Faq from '@core/components/Faq.astro';
import Access from '@core/components/Access.astro';
import Contact from '@core/components/Contact.astro';
import Footer from '@core/components/Footer.astro';
import StickyContactBar from '@core/components/StickyContactBar.astro';
import BackToTop from '@core/components/BackToTop.astro';
import { isSectionEnabled, orderedSectionIds, type SectionId } from '@core/lib/site';
import { productsPage, resolveAllProductItems } from '@core/lib/pages';

const sectionComponents = {
  features: Features,
  services: Service,
  flow: Flow,
  products: Products,
  works: Works,
  plans: Plans,
  faq: Faq,
  access: Access,
  contact: Contact,
} satisfies Record<SectionId, unknown>;

const productCount = isSectionEnabled('products') ? resolveAllProductItems(productsPage.items).length : 0;
const workCount = isSectionEnabled('works') ? (await getCollection('works')).length : 0;

const sectionEnabled: Record<SectionId, boolean> = {
  features: isSectionEnabled('features'),
  services: isSectionEnabled('services'),
  flow: isSectionEnabled('flow'),
  products: isSectionEnabled('products') && productCount > 0,
  works: isSectionEnabled('works') && workCount > 0,
  plans: isSectionEnabled('plans'),
  faq: isSectionEnabled('faq'),
  access: isSectionEnabled('access'),
  contact: isSectionEnabled('contact'),
};

const orderIds = orderedSectionIds();

// 表示されるセクションだけを数えて交互配色（偶数番目=グレー）を割り当てる
const visibleSections = orderIds
  .filter((id) => sectionEnabled[id])
  .map((id, i) => ({ id, Component: sectionComponents[id], muted: i % 2 === 0 }));
---

<Layout>
  <Header />
  <main>
    <Hero />
    {/* お知らせセクションはヒーローと「選ばれる3つの理由」の間に固定配置（sectionOrder 対象外） */}
    <News muted={false} />
    {
      visibleSections.map(({ Component, muted }) => <Component muted={muted} />)
    }
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
