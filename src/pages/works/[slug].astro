---
// ============================================================================
// src/pages/works/[slug].astro
// Content Collections（works）から「実績・活用事例」の型化ページを
// 自動生成する動的ルート（旧 src/pages/products/[slug].astro）。
// ============================================================================
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyContactBar from '../../components/StickyContactBar.astro';
import BackToTop from '../../components/BackToTop.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await work.render();
---

<Layout
  title={work.data.title ? `${work.data.title} | ${site.company.siteName}` : site.company.siteName}
  description={work.data.summary}
  image={work.data.image}
>
  <Header />
  <main>
    <article class="py-12 px-5">
      <div class="max-w-[820px] mx-auto">
        <nav class="text-[12px] text-ink-faint mb-6" aria-label="パンくずリスト">
          <a href="/" class="hover:text-primary">{site.productPage.breadcrumbHome}</a> <span aria-hidden="true">›</span> {work.data.title}
        </nav>

        {work.data.image && (
          <div class="rounded-2xl overflow-hidden border border-surface-border mb-8 md:max-w-[67%] md:mx-auto">
            <Image
              src={work.data.image}
              alt={work.data.imageAlt || work.data.title || ''}
              class="w-full h-auto object-cover block"
              width={820}
              height={480}
              format="webp"
              quality={80}
              fetchpriority="high"
              loading="eager"
            />
          </div>
        )}

        {work.data.title && (
          <h1 class="font-bold mb-3" style="font-size:clamp(24px,3.6vw,34px);">{work.data.title}</h1>
        )}
        {!!work.data.price && (
          <div class="text-[26px] font-bold text-primary mb-6">
            ¥{work.data.price.toLocaleString('ja-JP')}<span class="text-[14px] font-normal text-ink-soft">〜</span>
          </div>
        )}

        {work.data.summary && (
          <p class="text-[14px] leading-[1.9] text-secondary-light mb-8 whitespace-pre-line">{work.data.summary}</p>
        )}

        {work.data.specs.length > 0 && (
          <div class="mb-10 bg-surface-muted rounded-2xl p-6">
            {site.productPage.specsHeading && <h2 class="text-[14px] font-bold mb-4">{site.productPage.specsHeading}</h2>}
            <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
              {work.data.specs.map((spec) => (
                <li class="flex gap-2 items-start text-[13px] text-secondary-light">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none mt-0.5">
                    <path
                      d="M4 12.5l5 5L20 6"
                      style="stroke: var(--color-primary);"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {spec}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose-content text-[14px] leading-[1.9] text-secondary-light mb-10">
          <Content />
        </div>

        {site.productPage.ctaLabel && (
          <a
            href={site.productPage.ctaHref || '/#contact'}
            class="inline-flex items-center gap-2 text-white font-bold text-[15px] px-8 py-4 rounded-full bg-gradient-to-br from-primary to-primary-dark"
          >
            {site.productPage.ctaLabel} <span aria-hidden="true">›</span>
          </a>
        )}
      </div>
    </article>
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
