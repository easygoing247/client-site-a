---
// ============================================================================
// src/pages/products/[slug].astro
// Content Collections（products）から型化ページを自動生成する動的ルート。
// ============================================================================
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyContactBar from '../../components/StickyContactBar.astro';
import BackToTop from '../../components/BackToTop.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
---

<Layout
  title={`${product.data.title} | ${site.company.siteName}`}
  description={product.data.summary}
  image={product.data.mainImage}
>
  <Header />
  <main>
    <article class="py-12 px-5">
      <div class="max-w-[820px] mx-auto">
        <nav class="text-[12px] text-ink-faint mb-6" aria-label="パンくずリスト">
          <a href="/" class="hover:text-primary">{site.productPage.breadcrumbHome}</a> <span aria-hidden="true">›</span> {product.data.title}
        </nav>

        <div class="rounded-2xl overflow-hidden border border-surface-border mb-8">
          <Image
            src={product.data.mainImage}
            alt={product.data.title}
            class="w-full h-auto object-cover block"
            width={820}
            height={480}
            format="webp"
            fetchpriority="high"
            loading="eager"
          />
        </div>

        <h1 class="font-bold mb-3" style="font-size:clamp(24px,3.6vw,34px);">{product.data.title}</h1>
        <div class="text-[26px] font-bold text-primary mb-6">
          ¥{product.data.price.toLocaleString('ja-JP')}<span class="text-[14px] font-normal text-ink-soft">〜</span>
        </div>

        <p class="text-[14px] leading-[1.9] text-secondary-light mb-8">{product.data.summary}</p>

        {product.data.specs.length > 0 && (
          <div class="mb-10 bg-surface-muted rounded-2xl p-6">
            <h2 class="text-[14px] font-bold mb-4">{site.productPage.specsHeading}</h2>
            <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
              {product.data.specs.map((spec) => (
                <li class="flex gap-2 items-start text-[13px] text-secondary-light">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none mt-0.5">
                    <path
                      d="M4 12.5l5 5L20 6"
                      style="stroke: var(--color-primary);"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {spec}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="prose-content text-[14px] leading-[1.9] text-secondary-light mb-10">
          <Content />
        </div>

        <a
          href="/#contact"
          class="inline-flex items-center gap-2 text-white font-bold text-[15px] px-8 py-4 rounded-full bg-gradient-to-br from-primary to-primary-dark"
        >
          {site.productPage.ctaLabel} <span aria-hidden="true">›</span>
        </a>
      </div>
    </article>
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>
