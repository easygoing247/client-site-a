---
// ============================================================================
// src/pages/news/index.astro — 「お知らせ」一覧
// news コレクションを公開日の新しい順に一覧表示する（下書きは除外）。
// ・カテゴリフィルター（ボタン）でクライアントサイド絞り込み
// ・カード形式／リスト形式の表示切り替え
// ============================================================================
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import StickyContactBar from '../../components/StickyContactBar.astro';
import BackToTop from '../../components/BackToTop.astro';
import { site } from '../../lib/site';
import { newsPage } from '../../lib/pages';
import {
  getPublishedNews,
  newsCategoryLabel,
  formatNewsDate,
  collectNewsCategories,
} from '../../lib/news';

const posts = await getPublishedNews();
const categories = collectNewsCategories(posts);
const heading = newsPage.heading || 'お知らせ';
const listHeading = newsPage.listHeading || 'お知らせ一覧';

// アクティブ／非アクティブで付け外しするクラスは JS 側（ACTIVE_FILTER / INACTIVE_FILTER）と
// 一致させる。ベースクラスには背景・文字色・枠線色を含めない（競合を避けるため）。
// アクティブなカテゴリボタンは、テーマカラーの塗り＋うっすらとした発光状の
// box-shadow（バッジ風の「選ばれている感」）で非アクティブと明確に差をつける。
const filterBase = 'news-filter text-[12px] font-bold px-3.5 py-1.5 rounded-full border transition-colors';
const filterActive = 'bg-primary text-white border-primary shadow-[0_0_0_3px_rgba(var(--color-primary-rgb),0.18)]';
const filterInactive = 'bg-white text-secondary border-surface-border';
const viewBase = 'news-view inline-flex items-center gap-1.5 text-[12px] font-bold px-3 py-1 rounded-full transition-colors';
const viewActive = 'bg-primary text-white';
const viewInactive = 'text-secondary';
---

<Layout title={`${heading} | ${site.company.siteName}`} description={newsPage.lead || `${site.company.name}からのお知らせ一覧です。`}>
  <Header />
  <main>
    <PageHeader
      eyebrow="NEWS"
      title={heading}
      lead={newsPage.lead}
      crumbs={[{ label: site.productPage.breadcrumbHome || 'トップ', href: '/' }, { label: heading }]}
    />

    <section class="py-14 px-5">
      <div class="max-w-[900px] mx-auto">
        {listHeading && (
          <h2 class="text-center font-bold mb-10" style="font-size:clamp(20px,3vw,26px);">{listHeading}</h2>
        )}
        {posts.length === 0 ? (
          <p class="text-center text-[14px] text-ink-soft py-10">まだ記事がありません。</p>
        ) : (
          <>
            <div id="news-controls" class="flex flex-wrap items-center justify-between gap-4 mb-8">
              {categories.length > 0 && (
                <div class="flex flex-wrap items-center gap-2" role="group" aria-label="カテゴリで絞り込み">
                  <span class="text-[12px] font-bold text-secondary-light whitespace-nowrap">カテゴリで絞り込む：</span>
                  <button type="button" class={`${filterBase} ${filterActive}`} data-filter="all" aria-pressed="true">
                    すべて
                  </button>
                  {categories.map((cat) => (
                    <button type="button" class={`${filterBase} ${filterInactive}`} data-filter={cat.value} aria-pressed="false">
                      {cat.label}
                    </button>
                  ))}
                </div>
              )}

              <div class="flex gap-1 rounded-full border border-surface-border p-1" role="group" aria-label="表示形式の切り替え">
                <button type="button" class={`${viewBase} ${viewActive}`} data-view="card" aria-pressed="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="8" height="8" rx="1.5" fill="currentColor" />
                    <rect x="13" y="3" width="8" height="8" rx="1.5" fill="currentColor" />
                    <rect x="3" y="13" width="8" height="8" rx="1.5" fill="currentColor" />
                    <rect x="13" y="13" width="8" height="8" rx="1.5" fill="currentColor" />
                  </svg>
                  カード
                </button>
                <button type="button" class={`${viewBase} ${viewInactive}`} data-view="list" aria-pressed="false">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="4.5" width="18" height="3" rx="1.2" fill="currentColor" />
                    <rect x="3" y="10.5" width="18" height="3" rx="1.2" fill="currentColor" />
                    <rect x="3" y="16.5" width="18" height="3" rx="1.2" fill="currentColor" />
                  </svg>
                  リスト
                </button>
              </div>
            </div>

            <p id="news-empty" hidden class="text-center text-[14px] text-ink-soft py-10">
              このカテゴリの記事はまだありません。
            </p>

            <ul id="news-grid" data-view="card" class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 gap-6">
              {posts.map((post, i) => {
                const category = newsCategoryLabel(post.data.category);
                const href = `/news/${post.slug}`;
                const dateText = post.data.publishedAt ? formatNewsDate(post.data.publishedAt) : '';
                const dateAttr = post.data.publishedAt ? post.data.publishedAt.toISOString() : undefined;
                return (
                  <li class="news-item" data-category={post.data.category ?? ''}>
                    {/* カード形式 */}
                    <a href={href} class="news-card group flex flex-col h-full border border-surface-border rounded-card overflow-hidden bg-white hover:border-primary transition-colors">
                      {post.data.eyecatch && (
                        <Image
                          src={post.data.eyecatch}
                          alt={post.data.eyecatchAlt || post.data.title || ''}
                          class="w-full h-[180px] object-cover block"
                          width={450}
                          height={253}
                          format="webp"
                          fetchpriority={i === 0 ? 'high' : undefined}
                          loading={i === 0 ? 'eager' : 'lazy'}
                        />
                      )}
                      <div class="flex-1 px-5 py-5">
                        <div class="flex items-center gap-2 mb-2 text-[11px]">
                          {category && (
                            <span class="font-bold text-primary bg-primary-light px-[10px] py-1 rounded-full">{category}</span>
                          )}
                          {dateText && <time datetime={dateAttr} class="text-ink-faint">{dateText}</time>}
                        </div>
                        {post.data.title && (
                          <h2 class="text-[15px] font-bold leading-[1.6] mb-1 group-hover:text-primary transition-colors">{post.data.title}</h2>
                        )}
                        {post.data.summary && (
                          <p class="text-[12px] leading-[1.7] text-ink-soft m-0 line-clamp-3">{post.data.summary}</p>
                        )}
                      </div>
                    </a>

                    {/* リスト形式（初期は非表示） */}
                    <a href={href} class="news-row hidden group flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 py-4 border-b border-surface-border">
                      <div class="flex items-center gap-3 flex-none">
                        {dateText && <time datetime={dateAttr} class="text-[12px] text-ink-faint w-[92px]">{dateText}</time>}
                        {category && (
                          <span class="text-[11px] font-bold text-primary bg-primary-light px-[10px] py-1 rounded-full whitespace-nowrap">{category}</span>
                        )}
                      </div>
                      {post.data.title && (
                        <span class="text-[14px] font-bold text-secondary leading-[1.6] group-hover:text-primary transition-colors">{post.data.title}</span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        )}
      </div>
    </section>
  </main>
  <Footer />
  <StickyContactBar />
  <BackToTop />
</Layout>

<script>
  const controls = document.getElementById('news-controls');
  const grid = document.getElementById('news-grid');
  const emptyMsg = document.getElementById('news-empty');

  if (controls && grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.news-item'));
    const FILTER_ACTIVE = [
      'bg-primary',
      'text-white',
      'border-primary',
      'shadow-[0_0_0_3px_rgba(var(--color-primary-rgb),0.18)]',
    ];
    const FILTER_INACTIVE = ['bg-white', 'text-secondary', 'border-surface-border'];
    const VIEW_ACTIVE = ['bg-primary', 'text-white'];

    const swap = (el: Element, on: string[], off: string[]) => {
      off.forEach((c) => el.classList.remove(c));
      on.forEach((c) => el.classList.add(c));
    };

    // --- カテゴリ絞り込み ---
    const filterButtons = controls.querySelectorAll<HTMLButtonElement>('.news-filter');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          swap(b, on ? FILTER_ACTIVE : FILTER_INACTIVE, on ? FILTER_INACTIVE : FILTER_ACTIVE);
        });
        const filter = btn.dataset.filter ?? 'all';
        let visible = 0;
        items.forEach((li) => {
          const match = filter === 'all' || li.dataset.category === filter;
          li.hidden = !match;
          if (match) visible += 1;
        });
        if (emptyMsg) emptyMsg.hidden = visible !== 0;
      });
    });

    // --- カード / リスト 表示切り替え ---
    const viewButtons = controls.querySelectorAll<HTMLButtonElement>('.news-view');
    const applyView = (view: string) => {
      grid.setAttribute('data-view', view);
      const card = view === 'card';
      grid.classList.toggle('grid', card);
      grid.classList.toggle('sm:grid-cols-2', card);
      grid.classList.toggle('gap-6', card);
      grid.classList.toggle('block', !card);
      grid.classList.toggle('border-t', !card);
      grid.classList.toggle('border-surface-border', !card);
      items.forEach((li) => {
        li.querySelector('.news-card')?.classList.toggle('hidden', !card);
        const row = li.querySelector<HTMLElement>('.news-row');
        if (row) {
          row.classList.toggle('hidden', card);
          row.classList.toggle('flex', !card);
        }
      });
    };
    viewButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        viewButtons.forEach((b) => {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          if (on) VIEW_ACTIVE.forEach((c) => b.classList.add(c));
          else VIEW_ACTIVE.forEach((c) => b.classList.remove(c));
        });
        applyView(btn.dataset.view ?? 'card');
      });
    });
  }
</script>
